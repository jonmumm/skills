{
  "name": "procedural-3d-game",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "vite build",
    "check": "node scripts/check.mjs --url dist/index.html",
    "shoot": "node scripts/shoot.mjs --url dist/index.html",
    "playtest": "node scripts/playtest.mjs --url dist/index.html --steps playtests/smoke.json",
    "verify": "npm run build && npm run check && npm run playtest && npm run shoot"
  },
  "dependencies": {
    "three": "^0.186.0"
  },
  "devDependencies": {
    "playwright": "^1.56.0",
    "vite": "^8.0.0",
    "vite-plugin-singlefile": "^2.3.0"
  }
}
